# =============================================================
# UNIVERSO PORTAL — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================

# ─── SUPABASE ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── DATABASE (PRISMA) ────────────────────────────────────────
# Transaction pooler URL (for Prisma at runtime via PgBouncer)
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL (for Prisma migrations — bypasses PgBouncer)
DIRECT_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── APPLICATION ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Universo Portal
NODE_ENV=development

# ─── REDIS / UPSTASH (BullMQ Queue) ──────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# For BullMQ (ioredis-compatible URL)
REDIS_URL=redis://default:your-password@your-redis.upstash.io:6379

# ─── EMAIL (RESEND) ──────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@universo.club
RESEND_FROM_NAME=Universo Portal

# ─── AUTH ────────────────────────────────────────────────────
# Used to sign custom server-side tokens if needed
AUTH_SECRET=your-32-char-random-secret-here

# ─── STORAGE ─────────────────────────────────────────────────
# Max upload sizes in bytes (enforced server-side)
MAX_AVATAR_SIZE=5242880
MAX_ATTACHMENT_SIZE=52428800
MAX_DOCUMENT_SIZE=104857600

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=debug
# Optional: Axiom / Datadog for production log forwarding
# AXIOM_TOKEN=your-axiom-token
# AXIOM_DATASET=universo-portal-prod

# ─── AI (Future — leave blank until ready) ───────────────────
# GOOGLE_AI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-key

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
